<mjml lang="de">
  <mj-head>
    <mj-title>Neue Werkstatt-Anfrage von autofischer.ch</mj-title>
    <mj-preview>Neue Werkstatt-Anfrage über das Kontaktformular!</mj-preview>
    <mj-include path="../../partials/font.mjml" />
    <mj-attributes>
      <mj-all font-family="dm-sans, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f0f0f0">
    <!-- Logo Header -->
    <mj-include path="../../partials/logo.mjml" />

    <!-- Email Info -->
    <mj-section background-color="#fafafa" padding-top="40px" padding-bottom="40px">
      <mj-column width="500px">
        <mj-text font-size="20px" color="#626262">Neue Werkstatt-Anfrage von autofischer.ch</mj-text>
        <mj-text color="#525252">Die Anfrage wurde über das Werkstatt-Formular gesendet. Unten finden Sie die ausgefüllten Angaben.</mj-text>
      </mj-column>
    </mj-section>

    <!-- Email Content -->
    <mj-section background-color="white" padding="40px">
      <mj-column>
        <!-- Anfrage -->
        <mj-text font-size="14px" font-weight="bold">Anfrage</mj-text>
        <mj-divider border-width="1px" border-color="lightgrey" />
        <mj-table color="#2c2c2c" cellpadding="5">
          <tr>
            <th align="left" valign="top" style="font-weight: bold;">Was benötigen Sie</th>
            <td>[your-leistung]</td>
          </tr>
          <tr>
            <th align="left" valign="top" style="font-weight: bold;">Wann</th>
            <td>[your-wann]</td>
          </tr>
        </mj-table>

        <!-- Persönliche Informationen -->
        <mj-text font-size="14px" font-weight="bold">Persönliche Informationen</mj-text>
        <mj-divider border-width="1px" border-color="lightgrey" />
        <mj-table color="#2c2c2c" cellpadding="5">
          <tr>
            <th align="left" style="font-weight: bold;">Vorname</th>
            <td>[your-vorname]</td>
          </tr>
          <tr>
            <th align="left" style="font-weight: bold;">Nachname</th>
            <td>[your-nachname]</td>
          </tr>
          <tr>
            <th align="left" style="font-weight: bold;">Adresse</th>
            <td>[your-adresse]</td>
          </tr>
          <tr>
            <th align="left" style="font-weight: bold;">PLZ / Ort</th>
            <td>[your-plz-ort]</td>
          </tr>
          <tr>
            <th align="left" style="font-weight: bold;">Telefon</th>
            <td>[your-telefon]</td>
          </tr>
          <tr>
            <th align="left" style="font-weight: bold;">E-Mail</th>
            <td>[your-email]</td>
          </tr>
        </mj-table>

        <!-- Fahrzeug -->
        <mj-text font-size="14px" font-weight="bold">Fahrzeug Details</mj-text>
        <mj-divider border-width="1px" border-color="lightgrey" />
        <mj-table color="#2c2c2c" cellpadding="5">
          <tr>
            <th align="left" style="font-weight: bold;">Fahrzeug</th>
            <td>[your-fahrzeug]</td>
          </tr>
          <tr>
            <th align="left" style="font-weight: bold;">Kennzeichen</th>
            <td>[your-kennzeichen]</td>
          </tr>
        </mj-table>

        <!-- Beschreibung -->
        <mj-divider border-width="1px" border-color="lightgrey" />
        <mj-table color="#2c2c2c" cellpadding="5">
          <tr>
            <th align="left" style="font-weight: bold;">Beschreibung</th>
          </tr>
          <tr>
            <td>[your-beschreibung]</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Email Footer -->
    <mj-section full-width="full-width" padding="40px 0">
      <mj-column>
        <mj-text align="center" color="#525252">Dies ist eine Benachrichtigung, dass das Werkstatt-Formular auf Ihrer Website ([_site_title] [_site_url]) übermittelt wurde.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
